# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Gradle / NeoForge 开发环境
.gradle/
build/
run/
logs/
src/generated/

# 第二个客户端的独立运行目录（多人并发用例用）
run-alex/

# 工具脚本的字节码缓存
__pycache__/

# IDE 工程配置（IntelliJ IDEA）
.idea/
*.iml

# 本地回收站（删除文件的备份，只保留在本机）
.trash/

# 例外：Gradle Wrapper 必须入库，否则新克隆无法执行 gradlew
!gradle/wrapper/gradle-wrapper.jar
